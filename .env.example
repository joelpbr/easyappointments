# Copy this file to .env and fill in the values before running `docker compose up -d`.

# Public URL of the application, without the trailing slash (e.g. https://citas.example.com).
BASE_URL=http://localhost

# Host port the application listens on.
APP_PORT=80

# Database password, use a long random value (e.g. `openssl rand -hex 24`).
DB_PASSWORD=

# Default language (see application/config/config.php for the list) and time zone.
LANGUAGE=catalan
TZ=Europe/Madrid

# Outgoing email server. Leave SMTP_HOST empty to use the PHP mail() function instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Encryption: tls, ssl, or empty for none.
SMTP_CRYPTO=tls

# Address or subnet of the reverse proxy in front of the app, so client IPs are read from X-Forwarded-For.
PROXY_IPS=

# Days the daily database backups are kept in the storage volume (storage/backups).
BACKUP_RETENTION_DAYS=30
